<?xml version="1.0" encoding="utf-8"?>
<!--
  Split-screen layout:
  - Left panel: chat (RecyclerView + input bar)
  - Right panel: embedded WebView for government portals (hidden until a link is tapped)
  On phones (narrow screens) this stacks vertically instead of side-by-side —
  see the "sw600dp" note at the bottom of this file.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0B0F1A">

    <!-- LEFT: Chat panel -->
    <LinearLayout
        android:id="@+id/chatPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:clipToPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Type your message..."
                android:textColorHint="#8A93A6"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_input_field"
                android:padding="10dp" />

            <Button
                android:id="@+id/sendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send" />
        </LinearLayout>
    </LinearLayout>

    <!-- RIGHT: Embedded government portal panel -->
    <LinearLayout
        android:id="@+id/webPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#111827">

        <!-- Mini browser toolbar: back / forward / reload / url / close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp"
            android:gravity="center_vertical"
            android:background="#1A2233">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="Back" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_next"
                android:contentDescription="Forward" />

            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_popup_sync"
                android:contentDescription="Reload" />

            <TextView
                android:id="@+id/urlLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#8A93A6"
                android:singleLine="true"
                android:ellipsize="end"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="" />

            <ImageButton
                android:id="@+id/btnCloseWeb"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Close portal panel" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/webProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:visibility="gone" />

        <WebView
            android:id="@+id/portalWebView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>

<!--
  NOTE on phones vs tablets:
  Aapka screenshot ek wide (tablet/desktop) layout dikhata hai. Aapka app Android
  mobile-first hai, to phone (narrow) screens ke liye is file ko
  res/layout/activity_main.xml mein rakho (stacked/full-screen WebView, panel se
  chat replace ho jaye), aur isi file ko res/layout-sw600dp/activity_main.xml mein
  rakho taaki tablets pe side-by-side split-view dikhe. MainActivity.kt dono
  layouts ke saath kaam karta hai bina change ke.
-->
