<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/panel_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My details"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Yeh details sirf is phone mein encrypted save hoti hain, kisi server pe nahi jaati. Main inhe sirf .gov.in portals pe, aapke bolne par bharunga. OTP aur CAPTCHA aap khud daloge."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/fieldFirstName"
            style="@style/ProfileField"
            android:hint="First name"
            android:inputType="textPersonName|textCapWords" />

        <EditText
            android:id="@+id/fieldMiddleName"
            style="@style/ProfileField"
            android:hint="Middle name (optional)"
            android:inputType="textPersonName|textCapWords" />

        <EditText
            android:id="@+id/fieldLastName"
            style="@style/ProfileField"
            android:hint="Last name"
            android:inputType="textPersonName|textCapWords" />

        <EditText
            android:id="@+id/fieldFatherName"
            style="@style/ProfileField"
            android:hint="Father's name"
            android:inputType="textPersonName|textCapWords" />

        <EditText
            android:id="@+id/fieldDob"
            style="@style/ProfileField"
            android:hint="Date of birth (DD/MM/YYYY)"
            android:inputType="date" />

        <EditText
            android:id="@+id/fieldMobile"
            style="@style/ProfileField"
            android:hint="Mobile number (10 digit)"
            android:inputType="phone"
            android:maxLength="10" />

        <EditText
            android:id="@+id/fieldEmail"
            style="@style/ProfileField"
            android:hint="Email"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/fieldAadhaar"
            style="@style/ProfileField"
            android:hint="Aadhaar number (12 digit)"
            android:inputType="number"
            android:maxLength="12" />
    </LinearLayout>
</ScrollView>
